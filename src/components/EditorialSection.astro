---
interface Props {
  id?: string;
  label: string;
  labelNumber?: string;
  class?: string;
  withTopBorder?: boolean;
}

const { id, label, labelNumber, class: className = '', withTopBorder = true } = Astro.props;
---

<section
  id={id}
  class={`py-12 md:py-16 ${withTopBorder ? 'editorial-border-t' : ''} ${className}`}
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 items-start">
    <!-- Sidebar Label -->
    <div class="md:col-span-3 lg:col-span-3">
      <div class="md:sticky md:top-24 flex items-center md:items-start gap-2.5">
        {labelNumber && (
          <span class="font-mono text-xs text-fg-muted/60 dark:text-fg-dark-muted/60 tracking-wider">
            {labelNumber}
          </span>
        )}
        <h2 class="font-mono text-xs tracking-widest uppercase font-medium text-fg-muted dark:text-fg-dark-muted">
          {label}
        </h2>
      </div>
    </div>

    <!-- Flexible Content -->
    <div class="md:col-span-9 lg:col-span-9">
      <slot />
    </div>
  </div>
</section>
