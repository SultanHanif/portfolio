---
import { getCollection } from 'astro:content';
import EditorialSection from './EditorialSection.astro';

const allEducation = await getCollection('education');
const sortedEducation = allEducation.sort((a, b) => a.data.order - b.data.order);
---

<EditorialSection id="education" label="Education" labelNumber="05">
  <div class="space-y-6">
    {
      sortedEducation.map((edu) => (
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
          <div>
            <h3 class="text-base font-medium text-fg-light dark:text-fg-dark">
              {edu.data.degree}
            </h3>
            <p class="text-sm text-fg-muted dark:text-fg-dark-muted">
              {edu.data.institution} {edu.data.location ? `· ${edu.data.location}` : ''}
              {edu.data.honors && <span class="text-fg-light/80 dark:text-fg-dark/80 font-medium"> — {edu.data.honors}</span>}
            </p>
          </div>
          <div class="font-mono text-xs text-fg-muted dark:text-fg-dark-muted shrink-0">
            {edu.data.period}
          </div>
        </div>
      ))
    }
  </div>
</EditorialSection>
