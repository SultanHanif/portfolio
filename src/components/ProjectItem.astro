---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const formattedIndex = String(index + 1).padStart(2, '0');
const { title, tagline, category, year, stack, metrics } = project.data;
const projectUrl = `/projects/${project.id}`;
---

<article class="group relative py-6 md:py-8 border-b border-border-light dark:border-border-dark transition-colors duration-150 hover:bg-bg-subtle/50 dark:hover:bg-bg-dark-subtle/40 -mx-4 px-4 sm:-mx-6 sm:px-6 rounded-lg">
  <div class="flex flex-col space-y-4">
    <!-- Header Row: Number, Title, Category, Year, Arrow -->
    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
      <div class="flex items-baseline gap-3 sm:gap-4">
        <span class="font-mono text-xs text-fg-muted/60 dark:text-fg-dark-muted/60 tracking-wider">
          {formattedIndex}
        </span>
        <h3 class="text-lg sm:text-xl font-medium tracking-tight text-fg-light dark:text-fg-dark group-hover:text-accent-highlight transition-colors">
          <a href={projectUrl} class="focus:outline-none">
            <span class="absolute inset-0 z-10" aria-hidden="true"></span>
            {title}
          </a>
        </h3>
        <span class="hidden sm:inline-block text-xs font-mono px-2 py-0.5 border border-border-light dark:border-border-dark rounded text-fg-muted dark:text-fg-dark-muted">
          {category}
        </span>
      </div>

      <div class="flex items-center gap-3 font-mono text-xs text-fg-muted dark:text-fg-dark-muted self-end sm:self-auto">
        <span class="sm:hidden text-xs px-2 py-0.5 border border-border-light dark:border-border-dark rounded">
          {category}
        </span>
        <span>{year}</span>
        <span class="transform group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-150 text-fg-light dark:text-fg-dark" aria-hidden="true">
          ↗
        </span>
      </div>
    </div>

    <!-- Tagline & Description -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
      <div class="md:col-span-8 space-y-2">
        <p class="text-sm text-fg-light/90 dark:text-fg-dark/90 font-normal leading-relaxed">
          {tagline}
        </p>
        
        {metrics && metrics.length > 0 && (
          <div class="pt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-mono text-fg-muted dark:text-fg-dark-muted">
            <span class="text-emerald-600 dark:text-emerald-400 font-medium">Key Result:</span>
            <span>{metrics[0]}</span>
          </div>
        )}
      </div>

      <!-- Tech Stack Badges -->
      <div class="md:col-span-4 flex md:justify-end items-start">
        <div class="flex flex-wrap gap-1.5 font-mono text-[11px] text-fg-muted dark:text-fg-dark-muted">
          {stack.slice(0, 3).map((tech) => (
            <span class="px-1.5 py-0.5 bg-bg-light dark:bg-bg-dark border border-border-light/80 dark:border-border-dark/80 rounded">
              {tech}
            </span>
          ))}
          {stack.length > 3 && (
            <span class="px-1 py-0.5 text-fg-muted/60 dark:text-fg-dark-muted/60">
              +{stack.length - 3}
            </span>
          )}
        </div>
      </div>
    </div>
  </div>
</article>
