---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/siteConfig';
import { getCollection } from 'astro:content';

const allExperience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const allEducation = (await getCollection('education')).sort((a, b) => a.data.order - b.data.order);
const allCerts = (await getCollection('certifications')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title={`Curriculum Vitae — ${siteConfig.name}`}
  description={`Comprehensive professional Curriculum Vitae of ${siteConfig.name}, ${siteConfig.role}.`}
>
  <!-- Top Action Bar (hidden on print) -->
  <div class="no-print mb-8 pb-4 border-b border-border-light dark:border-border-dark flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-fg-muted hover:text-fg-light dark:text-fg-dark-muted dark:hover:text-fg-dark transition-colors"
    >
      <span aria-hidden="true">←</span>
      <span>Back to Portfolio</span>
    </a>

    <div class="flex items-center gap-3">
      <button
        onclick="window.print()"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-fg-light text-bg-light dark:bg-fg-dark dark:text-bg-dark rounded font-medium hover:opacity-90 transition-opacity"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 6 2 18 2 18 9"/>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
          <rect width="12" height="8" x="6" y="14"/>
        </svg>
        <span>Print / Save as PDF</span>
      </button>
    </div>
  </div>

  <!-- Main CV Container -->
  <article class="max-w-3xl mx-auto space-y-10 text-fg-light dark:text-fg-dark print:text-black print:max-w-none">
    
    <!-- 1. Header Section -->
    <header class="space-y-3 border-b border-border-light dark:border-border-dark print:border-gray-300 pb-6">
      <div class="space-y-1">
        <h1 class="text-3xl sm:text-4xl font-serif font-bold tracking-tight print:text-3xl">
          {siteConfig.name}
        </h1>
        <p class="text-base sm:text-lg text-fg-muted dark:text-fg-dark-muted print:text-gray-700 font-sans font-medium">
          {siteConfig.role}
        </p>
      </div>

      <!-- Contact Metadata -->
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs text-fg-muted dark:text-fg-dark-muted print:text-gray-600">
        <span>{siteConfig.location}</span>
        <span>•</span>
        <a href={`mailto:${siteConfig.email}`} class="hover:underline">{siteConfig.email}</a>
        {siteConfig.phone && (
          <>
            <span>•</span>
            <span>{siteConfig.phone}</span>
          </>
        )}
        <span>•</span>
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:underline">github.com/alexandervane</a>
        <span>•</span>
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="hover:underline">linkedin.com/in/alexandervane</a>
      </div>
    </header>

    <!-- 2. Professional Summary -->
    <section class="space-y-3 page-break-inside-avoid">
      <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-fg-muted dark:text-fg-dark-muted print:text-gray-900 border-b border-border-light dark:border-border-dark print:border-gray-200 pb-1">
        Professional Summary
      </h2>
      <p class="text-sm text-fg-light/90 dark:text-fg-dark/90 print:text-gray-800 leading-relaxed">
        {siteConfig.statement} {siteConfig.shortBio}
      </p>
    </section>

    <!-- 3. Experience -->
    <section class="space-y-6">
      <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-fg-muted dark:text-fg-dark-muted print:text-gray-900 border-b border-border-light dark:border-border-dark print:border-gray-200 pb-1">
        Professional Experience
      </h2>

      <div class="space-y-8">
        {
          allExperience.map((exp) => (
            <div class="space-y-2 page-break-inside-avoid">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <div>
                  <h3 class="text-base font-semibold text-fg-light dark:text-fg-dark print:text-black">
                    {exp.data.role}
                  </h3>
                  <div class="text-sm font-medium text-fg-muted dark:text-fg-dark-muted print:text-gray-700">
                    {exp.data.company} {exp.data.location ? `· ${exp.data.location}` : ''}
                  </div>
                </div>
                <div class="font-mono text-xs text-fg-muted dark:text-fg-dark-muted print:text-gray-600 shrink-0">
                  {exp.data.period}
                </div>
              </div>

              <ul class="space-y-1.5 text-xs sm:text-sm text-fg-light/85 dark:text-fg-dark/85 print:text-gray-800 list-none pl-0">
                {exp.data.achievements.map((ach) => (
                  <li class="relative pl-4 leading-relaxed before:content-['•'] before:absolute before:left-0 before:text-fg-muted dark:before:text-fg-dark-muted print:before:text-gray-500">
                    {ach}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 4. Selected Projects -->
    <section class="space-y-6 page-break-inside-avoid">
      <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-fg-muted dark:text-fg-dark-muted print:text-gray-900 border-b border-border-light dark:border-border-dark print:border-gray-200 pb-1">
        Selected Architectural Initiatives
      </h2>

      <div class="space-y-5">
        {
          allProjects.map((proj) => (
            <div class="space-y-1.5 page-break-inside-avoid">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <div class="flex items-baseline gap-2">
                  <h3 class="text-sm font-semibold text-fg-light dark:text-fg-dark print:text-black">
                    {proj.data.title}
                  </h3>
                  <span class="text-xs text-fg-muted dark:text-fg-dark-muted print:text-gray-600 font-mono">
                    ({proj.data.category} · {proj.data.role})
                  </span>
                </div>
                <span class="font-mono text-xs text-fg-muted dark:text-fg-dark-muted print:text-gray-600">
                  {proj.data.year}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-fg-light/85 dark:text-fg-dark/85 print:text-gray-800 leading-relaxed">
                {proj.data.description}
              </p>
              <div class="font-mono text-[11px] text-fg-muted dark:text-fg-dark-muted print:text-gray-600">
                Stack: {proj.data.stack.join(', ')}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 5. Technical Skills & Core Competencies -->
    <section class="space-y-4 page-break-inside-avoid">
      <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-fg-muted dark:text-fg-dark-muted print:text-gray-900 border-b border-border-light dark:border-border-dark print:border-gray-200 pb-1">
        Technical Competencies
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
        {
          siteConfig.skills.map((skill) => (
            <div class="space-y-1">
              <span class="font-mono text-xs font-semibold text-fg-light dark:text-fg-dark print:text-black block">
                {skill.category}
              </span>
              <span class="text-fg-muted dark:text-fg-dark-muted print:text-gray-700">
                {skill.items.join(' · ')}
              </span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 6. Education -->
    <section class="space-y-4 page-break-inside-avoid">
      <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-fg-muted dark:text-fg-dark-muted print:text-gray-900 border-b border-border-light dark:border-border-dark print:border-gray-200 pb-1">
        Education
      </h2>

      <div class="space-y-4">
        {
          allEducation.map((edu) => (
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <div>
                <h3 class="text-sm font-semibold text-fg-light dark:text-fg-dark print:text-black">
                  {edu.data.degree}
                </h3>
                <p class="text-xs sm:text-sm text-fg-muted dark:text-fg-dark-muted print:text-gray-700">
                  {edu.data.institution} {edu.data.location ? `· ${edu.data.location}` : ''}
                  {edu.data.honors && <span class="font-medium"> ({edu.data.honors})</span>}
                </p>
              </div>
              <div class="font-mono text-xs text-fg-muted dark:text-fg-dark-muted print:text-gray-600">
                {edu.data.period}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 7. Certifications -->
    <section class="space-y-3 page-break-inside-avoid">
      <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-fg-muted dark:text-fg-dark-muted print:text-gray-900 border-b border-border-light dark:border-border-dark print:border-gray-200 pb-1">
        Certifications & Credentials
      </h2>

      <div class="space-y-2 text-xs sm:text-sm">
        {
          allCerts.map((cert) => (
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <div class="text-fg-light dark:text-fg-dark print:text-black">
                <span class="font-medium">{cert.data.title}</span>
                <span class="text-fg-muted dark:text-fg-dark-muted print:text-gray-600 text-xs"> — {cert.data.issuer}</span>
              </div>
              <span class="font-mono text-xs text-fg-muted dark:text-fg-dark-muted print:text-gray-600">
                {cert.data.issueDate}
              </span>
            </div>
          ))
        }
      </div>
    </section>
  </article>
</Layout>
