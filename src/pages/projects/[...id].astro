---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, tagline, category, year, role, stack, metrics, liveUrl, githubUrl } = project.data;

// Get adjacent projects for navigation
const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allProjects.findIndex((p) => p.id === project.id);
const prevProject = currentIndex > 0 ? allProjects[currentIndex - 1] : null;
const nextProject = currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : null;
---

<Layout
  title={`${title} — Case Study | Alexander Vane`}
  description={tagline}
  article={true}
>
  <article class="max-w-3xl mx-auto space-y-12">
    <!-- Back to Overview -->
    <div class="font-mono text-xs">
      <a
        href="/#work"
        class="inline-flex items-center gap-1.5 text-fg-muted hover:text-fg-light dark:text-fg-dark-muted dark:hover:text-fg-dark transition-colors"
      >
        <span aria-hidden="true">←</span>
        <span>Back to Selected Work</span>
      </a>
    </div>

    <!-- Project Header -->
    <header class="space-y-6 pb-8 border-b border-border-light dark:border-border-dark">
      <div class="space-y-3">
        <div class="flex items-center gap-3 font-mono text-xs text-fg-muted dark:text-fg-dark-muted">
          <span class="px-2 py-0.5 border border-border-light dark:border-border-dark rounded">{category}</span>
          <span>•</span>
          <span>{year}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif font-normal tracking-tight text-fg-light dark:text-fg-dark">
          {title}
        </h1>

        <p class="text-lg sm:text-xl text-fg-muted dark:text-fg-dark-muted leading-relaxed font-sans">
          {tagline}
        </p>
      </div>

      <!-- Project Metadata Grid (Role, Stack, Links) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 pt-4 text-xs font-mono">
        <div class="space-y-1">
          <span class="text-fg-muted dark:text-fg-dark-muted uppercase tracking-wider block">Role</span>
          <span class="text-fg-light dark:text-fg-dark font-medium font-sans">{role}</span>
        </div>

        <div class="space-y-1">
          <span class="text-fg-muted dark:text-fg-dark-muted uppercase tracking-wider block">Technologies</span>
          <div class="flex flex-wrap gap-1">
            {stack.map((tech) => (
              <span class="px-1.5 py-0.5 bg-bg-subtle dark:bg-bg-dark-subtle border border-border-light dark:border-border-dark rounded text-[11px]">
                {tech}
              </span>
            ))}
          </div>
        </div>

        <div class="space-y-1 sm:col-span-2 md:col-span-1">
          <span class="text-fg-muted dark:text-fg-dark-muted uppercase tracking-wider block">Links</span>
          <div class="flex flex-wrap gap-3 pt-1">
            {liveUrl && (
              <a
                href={liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-fg-light dark:text-fg-dark hover:underline"
              >
                <span>Live System</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
            {githubUrl && (
              <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-fg-muted hover:text-fg-light dark:text-fg-dark-muted dark:hover:text-fg-dark"
              >
                <span>Repository</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </header>

    <!-- Key Metrics Highlight Banner -->
    {metrics && metrics.length > 0 && (
      <div class="p-5 sm:p-6 bg-bg-subtle/60 dark:bg-bg-dark-subtle/60 border border-border-light dark:border-border-dark rounded-lg space-y-3">
        <span class="font-mono text-xs uppercase tracking-widest text-fg-muted dark:text-fg-dark-muted font-semibold block">
          Key Performance & Architectural Metrics
        </span>
        <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 text-xs font-mono">
          {metrics.map((metric) => (
            <li class="p-3 bg-bg-light dark:bg-bg-dark border border-border-light/60 dark:border-border-dark/60 rounded flex items-start gap-2">
              <span class="text-emerald-500 font-bold" aria-hidden="true">✓</span>
              <span class="text-fg-light/90 dark:text-fg-dark/90 leading-snug">{metric}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Main Markdown Case Study Content -->
    <div class="prose prose-neutral dark:prose-invert max-w-none prose-headings:font-serif prose-headings:font-normal prose-h3:text-xl prose-p:text-fg-light/85 dark:prose-p:text-fg-dark/85 prose-p:leading-relaxed prose-li:text-sm">
      <Content />
    </div>

    <!-- Bottom Navigation Footer -->
    <nav class="pt-12 border-t border-border-light dark:border-border-dark grid grid-cols-2 gap-4 font-mono text-xs" aria-label="Project Case Studies">
      <div>
        {prevProject && (
          <a
            href={`/projects/${prevProject.id}`}
            class="group flex flex-col space-y-1 text-left hover:text-accent-highlight transition-colors"
          >
            <span class="text-fg-muted dark:text-fg-dark-muted">← Previous Project</span>
            <span class="font-sans font-medium text-sm text-fg-light dark:text-fg-dark group-hover:text-accent-highlight">
              {prevProject.data.title}
            </span>
          </a>
        )}
      </div>

      <div class="text-right">
        {nextProject && (
          <a
            href={`/projects/${nextProject.id}`}
            class="group flex flex-col space-y-1 text-right hover:text-accent-highlight transition-colors"
          >
            <span class="text-fg-muted dark:text-fg-dark-muted">Next Project →</span>
            <span class="font-sans font-medium text-sm text-fg-light dark:text-fg-dark group-hover:text-accent-highlight">
              {nextProject.data.title}
            </span>
          </a>
        )}
      </div>
    </nav>
  </article>
</Layout>
